-- Courier-Analytic PowerBI measures (paste into Model -> New measure)
-- Tables: kpi_daily, discrepancies, courier_scorecard, merchant_health

Total Leakage = SUM ( discrepancies[variance_rs] )

Disputed AWBs = DISTINCTCOUNT ( discrepancies[awb_number] )

Dispute Pct =
DIVIDE ( [Disputed AWBs], DISTINCTCOUNT ( kpi_daily[orders] ) + 0 ) * 0
    + DIVIDE (
        DISTINCTCOUNT ( discrepancies[awb_number] ),
        CALCULATE ( DISTINCTCOUNT ( kpi_daily[orders] ), ALL ( discrepancies ) )
    )

Avg DSO = AVERAGE ( kpi_daily[avg_dso_days] )

Leakage WoW Pct =
VAR PrevWk =
    CALCULATE ( [Total Leakage], DATEADD ( kpi_daily[kpi_date], -7, DAY ) )
RETURN
    DIVIDE ( [Total Leakage] - PrevWk, PrevWk )

High Risk Leakage =
CALCULATE ( [Total Leakage], discrepancies[severity] = "HIGH" )

Tier-3 Leakage Pct =
DIVIDE (
    CALCULATE ( [Total Leakage], discrepancies[tier] = "Tier-3" ),
    [Total Leakage]
)

Reliability Score =
0.4 * AVERAGE ( courier_scorecard[ontime] )
    + 0.35 * ( 1 - AVERAGE ( courier_scorecard[dispute] ) )
    + 0.25 * ( 1 - AVERAGE ( courier_scorecard[phantom] ) )

-- ---- Olist real-data page (tables: olist_review_impact, olist_monthly, olist_seller_late)
Olist Late Rate =
DIVIDE (
    CALCULATE ( SUM ( olist_monthly[late_orders] ) ),
    SUM ( olist_monthly[orders_] )
)

Olist Bad Review Rate (Late) =
DIVIDE (
    CALCULATE (
        SUM ( olist_review_impact[orders_] ),
        olist_review_impact[late_flag] = "Late",
        olist_review_impact[sentiment] = "Bad"
    ),
    CALCULATE (
        SUM ( olist_review_impact[orders_] ),
        olist_review_impact[late_flag] = "Late"
    )
)

Olist Bad Review Rate (On-time) =
DIVIDE (
    CALCULATE (
        SUM ( olist_review_impact[orders_] ),
        olist_review_impact[late_flag] = "On-time",
        olist_review_impact[sentiment] = "Bad"
    ),
    CALCULATE (
        SUM ( olist_review_impact[orders_] ),
        olist_review_impact[late_flag] = "On-time"
    )
)

Olist Review Lift (pp) =
[Olist Bad Review Rate (Late)] - [Olist Bad Review Rate (On-time)]
